{
  "expo": {
    "name": "iScore - Credit Monitoring",
    "slug": "iscore-credit-app",
    "version": "1.0.0",
    "description": "Credit score monitoring application for the Egyptian market",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "iscore",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "privacy": "public",
    "platforms": ["ios", "android", "web"],
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": ["expo-router", "expo-font", "expo-web-browser"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
